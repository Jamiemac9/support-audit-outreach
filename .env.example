# Copy this file to .env and fill in your keys.
# .env is gitignored — it never gets committed.

# Companies House API key
# Get one free at https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Charity Commission API key (only needed for the live API; the bulk
# download used by script 03 does not require a key)
# Get one free at https://api-portal.charitycommission.gov.uk/
CHARITY_COMMISSION_API_KEY=
